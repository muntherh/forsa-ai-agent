# Vapi public/client-side key — safe to expose in the browser bundle by
# design (it is scoped to starting WebRTC calls only). Get it from your Vapi
# dashboard: https://dashboard.vapi.ai/org/api-keys
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here

# OpenAI API key — server-side ONLY (no NEXT_PUBLIC_ prefix, never sent to
# the browser). Used exclusively by app/api/evaluate/route.ts to turn a
# finished interview's transcript into the structured JSON scorecard, via
# GPT-4o Structured Outputs. Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
