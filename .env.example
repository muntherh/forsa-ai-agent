# Vapi public/client-side key — safe to expose in the browser bundle by
# design (it is scoped to starting WebRTC calls only). Get it from your Vapi
# dashboard: https://dashboard.vapi.ai/org/api-keys
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Anthropic API key — server-side ONLY (no NEXT_PUBLIC_ prefix, never sent
# to the browser). Used exclusively by app/api/evaluate/route.ts to turn a
# finished interview's transcript into the structured JSON scorecard +
# action plan, via Claude Structured Outputs.
# Get it from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vapi private/server-side key — server-side ONLY, never sent to the
# browser. Optional: without it the app still works end-to-end using only
# the transcript accumulated client-side during the call. When set, it's
# used by lib/vapi-server.ts as a fallback to fetch the call's own
# server-recorded transcript from Vapi's REST API, in case the client-side
# transcript ever comes back thinner (e.g. a backgrounded tab dropping a
# message event). Get it from the same page as the public key above.
VAPI_PRIVATE_KEY=your_vapi_private_key_here
